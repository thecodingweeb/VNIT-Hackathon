# ============================================================
# TigerWatch Backend — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# --- JWT (used for custom token validation only) ---
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- App ---
APP_NAME=TigerWatch API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# --- Storage Buckets ---
BUCKET_RAW_IMAGES=raw-images
BUCKET_THUMBNAILS=thumbnails
BUCKET_CROPS=crops
BUCKET_QUARANTINE=quarantine
BUCKET_MODELS=models
BUCKET_EXPORTS=exports
