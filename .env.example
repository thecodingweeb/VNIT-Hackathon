SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJhenVuZGRhdGFqaGd3Z2hjenhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5NjE3NzIsImV4cCI6MjEwMjUzNzc3Mn0.uXi6X9egQk1KjwSjeFvpWR3HfcC7zj8rpChGyWpLOmg
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJhenVuZGRhdGFqaGd3Z2hjenhvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njk2MTc3MiwiZXhwIjoyMTAyNTM3NzcyfQ.W5wKpPNvNtuurZ0nRrAfpVqNckDLepNWtdhZ4v4m-xE
# Direct database connection (for ML worker / migrations)
# Found in: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE JWT SECRET (for custom JWT validation in FastAPI middleware)
# ──────────────────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# ──────────────────────────────────────────────────────────────────────────────
# FASTAPI APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
APP_NAME=TigerWatch Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: UPSTASH REDIS (for rate limiting persistence)
# ──────────────────────────────────────────────────────────────────────────────
# If not set, rate limiting uses in-memory store (no persistence across restarts)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# ML WORKER SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
# GPU device index (-1 for CPU fallback)
GPU_DEVICE=0
# MegaDetector confidence threshold (default 0.15 for blank filtering)
MD_CONFIDENCE_THRESHOLD=0.15
# Tiger detection minimum confidence
TIGER_DETECTION_CONFIDENCE=0.4
# Cosine similarity thresholds for identity matching
MATCH_AUTO_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.60
# Maximum batch size for GPU inference
MAX_BATCH_SIZE=32

# ──────────────────────────────────────────────────────────────────────────────
# STORAGE SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10240
# Thumbnail dimensions
THUMBNAIL_SIZE=256
# Crop dimensions for tiger flank
CROP_SIZE=448

# ──────────────────────────────────────────────────────────────────────────────
# ALERT NOTIFICATION SETTINGS (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# SMTP for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@tigerwatch.local

# SMS via Twilio (for BUFFER_APPROACH high-priority alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
